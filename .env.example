# Environment variables for the EIC Chula website (declared in src/env.ts).
# Copy this file to .env for local development. On Vercel, set the same names in
# Project Settings > Environment Variables. Every variable is optional so builds
# work without secrets, but the features below need them.
# See docs/setup-supabase.md for where each value comes from.

# --- Database ---------------------------------------------------------------
# Postgres connection string.
# Production (Vercel): the Supabase TRANSACTION pooler, port 6543:
#   postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# For `pnpm db:migrate`, `pnpm db:seed` and Drizzle Studio from a laptop, prefer the
# SESSION pooler (same host, port 5432) or the direct connection.
DATABASE_URL=""

# --- Supabase (sign in and uploads) ------------------------------------------
# Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=""
# Publishable key (sb_publishable_...). Used for sign in.
SUPABASE_PUBLISHABLE_KEY=""
# Secret key (sb_secret_...). Server only: used for Storage uploads. Never share it.
SUPABASE_SECRET_KEY=""
# Legacy keys, only read when the new keys above are not set.
# SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# --- Admin panel ---------------------------------------------------------------
# Comma separated emails that may always sign in to /admin and become owners on
# their first sign in. Remove once owners are invited in Admin > Settings.
ADMIN_EMAILS=""

# WARNING: local development only. When set, every request during `pnpm dev` is
# treated as signed in with this email (no password, no Supabase needed). It is
# ignored in production builds, but never set it on Vercel or any shared server.
# DEV_AUTH_EMAIL="you@example.com"

# --- Local example (no Docker) ---------------------------------------------------
# A throwaway Postgres 16 on 127.0.0.1:54329 with stand-ins for Supabase's schemas:
#   scripts/local-db.sh start
#   pnpm db:migrate && pnpm db:seed
# then use:
# DATABASE_URL="postgres://postgres:postgres@127.0.0.1:54329/postgres"
# DEV_AUTH_EMAIL="you@example.com"
# ADMIN_EMAILS="you@example.com"
# (`scripts/local-db.sh stop` stops it, `scripts/local-db.sh reset --seed` starts over.)
