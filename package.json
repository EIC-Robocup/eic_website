{
	"name": "eic-website",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.1",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"preview:vercel": "NODE_OPTIONS=--no-experimental-require-module vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/migrate.ts",
		"db:seed": "node scripts/seed.ts",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.119.2",
		"drizzle-orm": "0.45.4",
		"katex": "0.19.1",
		"marked": "^18.3.0",
		"postgres": "^4.1.1",
		"sanitize-html": "^2.17.5",
		"shiki": "4.6.0",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@fontsource/caveat": "^5.3.0",
		"@fontsource/ibm-plex-sans-thai": "^5.3.0",
		"@google/model-viewer": "4.4.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.81.0",
		"@sveltejs/adapter-vercel": "^7.0.3",
		"@sveltejs/enhanced-img": "^1.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24",
		"@types/sanitize-html": "^2.16.2",
		"bits-ui": "^2.22.0",
		"cn": "^0.5.2",
		"drizzle-kit": "^0.31.11",
		"mermaid": "12.3.0",
		"shadcn-svelte": "^1.8.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.5",
		"three": "0.183.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	}
}
